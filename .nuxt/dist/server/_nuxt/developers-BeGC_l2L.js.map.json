} })\n    state.value = 'done'\n    track('lead:upload_project_submitted')\n  } catch {\n    state.value = 'error'\n    track('lead:upload_project_failed')\n  }\n}\n</script>\n\n<template>\n  <section id=\"developers\" class=\"section developer\">\n    <div class=\"copy\">\n      <p class=\"eyebrow\">FOR DEVELOPERS &amp; MASTER BROKERS</p>\n      <h2 class=\"display\">One upload.<br />One intelligent brief.</h2>\n      <p class=\"body\">\n        Connect your inventory once. Every broker pitching your project gets an AI that\n        knows your live units, prices and payment plans — and you see exactly how it's\n        being pitched.\n      </p>\n    </div>\n\n    <form v-if=\"state !== 'done'\" class=\"lead-form\" @submit.prevent=\"submit\">\n      <div class=\"field\">\n        <label for=\"lead-name\">Your name</label>\n        <input id=\"lead-name\" v-model=\"form.name\" required placeholder=\"Full name\" />\n      </div>\n      <div class=\"field\">\n        <label for=\"lead-company\">Company</label>\n        <input id=\"lead-company\" v-model=\"form.company\" placeholder=\"Developer / brokerage\" />\n      </div>\n      <div class=\"field\">\n        <label for=\"lead-contact\">Email or WhatsApp</label>\n        <input id=\"lead-contact\" v-model=\"form.contact\" required placeholder=\"How do we reach you?\" />\n      </div>\n      <div class=\"field\">\n        <label for=\"lead-project\">Project</label>\n        <input id=\"lead-project\" v-model=\"form.project\" required placeholder=\"Which development do you want on Rechitta?\" />\n      </div>\n      <button class=\"btn btn-primary\" type=\"submit\" :disabled=\"state === 'sending'\">\n        {{ state === 'sending' ? 'Sending…' : 'Upload your project →' }}\n      </button>\n      <p v-if=\"state === 'error'\" class=\"form-error\">Something went wrong — try again or write to aryaman@rechitta.com.</p>\n    </form>\n\n    <div v-else class=\"lead-done\">\n      <p class=\"display\">We're on it.</p>\n      <p class=\"body\">The team will reach out within one business day to get your project live.</p>\n    </div>\n  </section>\n</template>\n\n<style scoped>\n.developer {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 64px;\n  align-items: center;\n}\n.developer h2 { font-size: clamp(34px, 4.5vw, 56px); margin: 18px 0 16px; }\n.body { color: var(--text-secondary); line-height: 1.65; max-width: 440px; }\n\n.lead-form {\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n  padding: 32px;\n  border: 1px solid rgba(250, 250, 249, 0.1);\n  border-radius: 18px;\n  background: rgba(250, 250, 249, 0.02);\n}\n.lead-form .btn { justify-content: center; margin-top: 6px; }\n.form-error { font-size: 13px; color: #e57373; }\n\n.lead-done { text-align: center; }\n.lead-done .display { font-size: 34px; margin-bottom: 10px; }\n\n@media (max-width: 860px) {\n  .developer { grid-template-columns: 1fr; gap: 40px; }\n}\n</style>\n","<script setup lang=\"ts\">\nconst { track } = useTrack()\n\nuseHead({\n  title: 'Rechitta for Developers & Master Brokers',\n  meta: [\n    {\n      name: 'description',\n      content:\n        'Put your off-plan project on Rechitta. Every broker selling it gets an AI that knows your live inventory — and you see exactly how it is being pitched.'\n    }\n  ]\n})\n\nonMounted(() => track('persona:landing_view', { persona: 'developer' }))\n\nconst props = [\n  {\n    title: 'Brief every broker at once',\n    body: 'No more assembling teams for repeated in-person sessions. Your project knowledge reaches the whole network the moment it changes.'\n  },\n  {\n    title: 'Inventory that is never stale',\n    body: 'Prices, availability and payment plans update live. Every pitch a broker makes is made from your current truth.'\n  },\n  {\n    title: 'See how you are being sold',\n    body: 'Analytics on briefings, engagement and broker performance for every development you put on the platform.'\n  }\n]\n</script>\n\n<template>\n  <main>\n    <PersonaHero\n      eyebrow=\"FOR DEVELOPERS & MASTER BROKERS\"\n      title=\"One upload.&#10;One intelligent brief.\"\n      subtitle=\"Put your project on Rechitta and every broker selling it gets an AI that knows your live inventory, prices and payment plans — while you see exactly how it's being pitched.\"\n    >\n      <a href=\"#upload\" class=\"btn btn-primary\" @click=\"track('cta:upload_project_click', { placement: 'developers_hero' })\">\n        Upload your project\n      </a>\n      <a href=\"mailto:aryaman@rechitta.com\" class=\"btn btn-ghost\" @click=\"track('cta:talk_to_us_click', { placement: 'developers_hero' })\">\n        Talk to us\n      </a>\n    </PersonaHero>\n\n    <section class=\"section value-props\">\n      <article v-for=\"p in props\" :key=\"p.title\" class=\"card\">\n        <h3>{{ p.title }}</h3>\n        <p>{{ p.body }}</p>\n      </article>\n    </section>\n\n    <div id=\"upload\">\n      <SectionDeveloper />\n    </div>\n\n    <PressStrip />\n  </main>\n</template>\n\n<style scoped>\n.value-props {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n  padding-top: 0;\n}\n.card {\n  border: 1px solid rgba(250, 250, 249, 0.1);\n  border-radius: 12px;\n  background: rgba(250, 250, 249, 0.02);\n  padding: 24px;\n}\n.card h3 {\n  font-family: var(--font-display);\n  font-weight: 400;\n  font-size: 21px;\n  margin-bottom: 10px;\n}\n.card p {\n  color: var(--text-secondary);\n  font-size: 14px;\n  line-height: 1.6;\n}\n@media (max-width: 860px) {\n  .value-props { grid-template-columns: 1fr; }\n}\n</style>\n"],"version":3}